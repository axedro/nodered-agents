# LLM Configuration
LLM_PROVIDER=ollama  # ollama, openai, anthropic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral  # o llama2, codellama, etc.

# OpenAI (opcional)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic (opcional)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-opus-20240229

# Vector Database
CHROMA_PERSIST_DIR=./data/chroma_db

# Node-RED Configuration
NODERED_URL=http://localhost:1880
NODERED_ADMIN_AUTH=  # Si tienes autenticación

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Feedback & Reinforcement Learning
MIN_FEEDBACK_SCORE=3  # Mínimo score para considerar "flujo bueno"
SIMILARITY_THRESHOLD=0.95  # Para cache hits
